# Frontend - Node
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Audio de sesiones: material clinico sensible.
# Se ignora por extension en cualquier carpeta, no solo en backend/uploads/,
# para que un archivo suelto en la raiz no termine en el repositorio.
*.mp3
*.wav
*.m4a
*.ogg
*.flac
*.webm
