.env
.env.local
.DS_Store

# Backend - Python
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Datos generados (audios y análisis: información clínica sensible)
backend/uploads/
backend/transcriptions/
backend/visualizations/
backend/results/
