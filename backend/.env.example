# Copiá este archivo como .env (en la raíz del repo o en backend/).

# =====================================================================
# Proveedor del LLM
#
# Sólo se usa para traducir, clasificar emoción y redactar el resumen.
# Las métricas acústicas NO dependen de esto: si falla, el análisis de
# señal (transcripción, hablantes, prosodia) igual se completa.
#
# Si no ponés LLM_PROVIDER, se elige solo según qué key haya cargada
# (prefiere Claude). Descomentá para forzar uno:
# LLM_PROVIDER=claude
# LLM_PROVIDER=gemini
# =====================================================================

# --- Claude / Anthropic ---
# OJO: la suscripción Claude Pro/Max NO habilita la API. Son productos con
# facturación separada. La API se paga con créditos comprados acá:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-opus-5 (mejor calidad) | claude-sonnet-5 | claude-haiku-4-5 (más barato)
CLAUDE_MODEL=claude-opus-5

# --- Gemini / Google ---
# Gratis: https://aistudio.google.com/apikey
# OJO: el plan gratuito limita requests POR DIA Y POR MODELO (20/dia en el
# flash mas nuevo). Por eso las traducciones (muchas requests) van al modelo
# lite, que tiene su propio cupo, y el resumen (una sola) al modelo bueno.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest             # resumen clinico
GEMINI_MODEL_BULK=gemini-flash-lite-latest   # traduccion y emocion

# Enunciados por request, y requests simultaneos.
# Chunks grandes = menos requests = menos presion sobre la cuota diaria.
# El paralelismo por defecto es 3 con Gemini (cuota baja) y 6 con Claude.
LLM_CHUNK_SIZE=40
LLM_MAX_PARALLEL=3

# =====================================================================
# Transcripción
# =====================================================================
# tiny | base | small | medium | large-v3 | distil-large-v3
WHISPER_MODEL=small
# int8 (CPU) | float16 (GPU)
WHISPER_COMPUTE=int8
# cpu | cuda
WHISPER_DEVICE=cpu
CPU_THREADS=4

# =====================================================================
# Servidor
# =====================================================================
MAX_UPLOAD_MB=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
