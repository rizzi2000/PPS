# Copiá este archivo como .env y completá la API key.
# Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Opcionales ---
GEMINI_MODEL=gemini-flash-latest

# tiny | base | small | medium | large-v3 | distil-large-v3
WHISPER_MODEL=small
# int8 (CPU) | float16 (GPU)
WHISPER_COMPUTE=int8
# cpu | cuda
WHISPER_DEVICE=cpu
CPU_THREADS=4

MAX_UPLOAD_MB=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
